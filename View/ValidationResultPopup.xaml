<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="ProjetPOO.View.ValidationResultPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Color="Transparent">

    <Frame
        WidthRequest="520"
        MaximumHeightRequest="600"
        Padding="0"
        CornerRadius="15"
        HasShadow="True"
        BackgroundColor="White">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <VerticalStackLayout
                Grid.Row="0"
                Padding="20,18"
                Spacing="6">

                <Label
                    x:Name="TitleLabel"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#111111"
                    HorizontalOptions="Center" />

                <Label
                    x:Name="SummaryLabel"
                    FontSize="14"
                    TextColor="#6B7280"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <BoxView
                Grid.Row="0"
                HeightRequest="1"
                BackgroundColor="#E5E5E5"
                VerticalOptions="End" />

            <!-- Content -->
            <ScrollView Grid.Row="1">

                <VerticalStackLayout
                    x:Name="ErrorsLayout"
                    Padding="20"
                    Spacing="10" />

            </ScrollView>

            <!-- Footer -->
            <Grid
                Grid.Row="2"
                Padding="20"
                ColumnDefinitions="*,Auto">

                <Button
                    Grid.Column="1"
                    Text="Fermer"
                    Clicked="CloseButton_Clicked"
                    BackgroundColor="#3A6EA5"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="18,10"
                    FontAttributes="Bold" />

            </Grid>

        </Grid>
    </Frame>
</toolkit:Popup>