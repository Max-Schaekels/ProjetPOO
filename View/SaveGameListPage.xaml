<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetPOO.View.SaveGameListPage"
             BackgroundColor="#F3F3F3">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <Button Text="← Retour"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#2D2D32"
                    Padding="0"
                    HorizontalOptions="Start" />

            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="30"
                                   Margin="0,0,0,6">

                <Button Text="Nouvelle partie"
                        Command="{Binding BackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#2D2D32"
                        Padding="0" />

                <VerticalStackLayout Spacing="4">

                    <Button Text="Charger partie"
                            BackgroundColor="Transparent"
                            TextColor="#C2187A"
                            FontAttributes="Bold"
                            Padding="0"
                            IsEnabled="False" />

                    <BoxView HeightRequest="2"
                             WidthRequest="105"
                             BackgroundColor="#C2187A" />

                </VerticalStackLayout>

            </HorizontalStackLayout>

            <Label Text="{Binding PageTitle}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#111111"
                   HorizontalOptions="Center" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SaveGames}"
                                 Spacing="12">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>

                        <Frame CornerRadius="15"
                               Padding="16"
                               HasShadow="False"
                               BorderColor="#DDDDDD"
                               BackgroundColor="White">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="4">

                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#111111" />

                                    <Label Text="{Binding LastSavedAt, StringFormat='Dernière sauvegarde : {0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="13"
                                           TextColor="#6B7280" />

                                    <Label Text="{Binding CreatedAt, StringFormat='Créée le : {0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="13"
                                           TextColor="#6B7280" />

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                     Spacing="8"
                                     VerticalOptions="Center">

                                    <Button Text="Charger"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LoadSaveGameCommand}"
                                        CommandParameter="{Binding}"
                                        BackgroundColor="#3A6EA5"
                                        TextColor="White"
                                        CornerRadius="10"
                                        Padding="18,10"
                                        FontAttributes="Bold" />

                                    <Button Text="Supprimer"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteSaveGameCommand}"
                                        CommandParameter="{Binding}"
                                        BackgroundColor="#B83232"
                                        TextColor="White"
                                        CornerRadius="10"
                                        Padding="18,10"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Grid>
                        </Frame>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>