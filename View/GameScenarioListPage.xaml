<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetPOO.View.GameScenarioListPage"
             BackgroundColor="#F3F3F3">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <Button Text="← Retour"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#2D2D32"
                    Padding="0"
                    HorizontalOptions="Start" />

            <Label Text="{Binding PageTitle}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#111111"
                   HorizontalOptions="Center" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Scenarios}"
                                 Spacing="12">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>

                        <Frame CornerRadius="15"
                               Padding="16"
                               HasShadow="False"
                               BorderColor="#DDDDDD"
                               BackgroundColor="White">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="4">

                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#111111" />

                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="#6B7280"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Jouer"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayScenarioCommand}"
                                        CommandParameter="{Binding}"
                                        BackgroundColor="#3A6EA5"
                                        TextColor="White"
                                        CornerRadius="10"
                                        Padding="18,10"
                                        FontAttributes="Bold" />

                            </Grid>
                        </Frame>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>